{
  "name": "profile",
  "version": "2.0.0",
  "private": true,
  "author": "Kiran Shrestha",
  "description": "Personal portfolio and GitHub profile built with RxHtml framework",
  "homepage": "https://kiransth77.github.io/profile/",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/input.css -o ./public/css/styles.css --minify",
    "watch:css": "npx tailwindcss -i ./src/input.css -o ./public/css/styles.css --watch",
    "start": "npm run build:css && npx http-server public -p 8080 -o",
    "dev": "npm run watch:css & npx http-server public -p 8080 -o",
    "build": "npm run build:css && node scripts/build.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "autoprefixer": "^10.4.22",
    "esbuild": "^0.24.0",
    "gh-pages": "^6.3.0",
    "http-server": "^14.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18"
  },
  "dependencies": {
    "@kiransth/rxhtmx": "^2.0.0",
    "framer-motion": "^12.23.24"
  }
}
